# Works with ANY OpenAI-compatible provider. Fill all three values.
LLM_API_KEY=your_key_here

# Pick one base URL (check your provider's docs if it has changed):
#   Google Gemini : https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq          : https://api.groq.com/openai/v1
#   OpenRouter    : https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.groq.com/openai/v1

# Pick a model that is available on your provider's FREE tier (see its dashboard / model list).
LLM_MODEL=your_model_name_here
